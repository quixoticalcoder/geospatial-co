# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/geospatial_co

# Optional checkpointer URL (not wired into the default graph)
LANGGRAPH_CHECKPOINT_URL=postgresql://user:password@localhost:5432/geospatial_co

# LLM
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1000
GROQ_API_KEY=your_groq_api_key_here

# LangSmith / LangGraph Studio
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=geospatial-co

# App
APP_ENV=development
LOG_LEVEL=INFO
H3_RESOLUTION=8
